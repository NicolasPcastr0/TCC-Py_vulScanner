# Configurações de API para a Camada de IA do SecureScan

# Opção 1: Chave da API do OpenRouter (Recomendado - Acesso gratuito a Llama 3.3, DeepSeek, etc.):
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opção 2: Chave direta do Google Gemini:
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=

# Opção 3: Chave direta da OpenAI:
OPENAI_API_KEY=
